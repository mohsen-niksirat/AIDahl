# Copy to Deployka env or local .env — NEVER commit real secrets

BOT_TOKEN=
DAHL_API_KEY=
DAHL_BASE_URL=https://inference.dahl.global/v1
SUPABASE_URL=
SUPABASE_KEY=
BOT_VERSION=1.0.0-final

# BYOK: if true, users without a personal key may use DAHL_API_KEY
ALLOW_SHARED_KEY=true

# Display quota for shared usage menu
TOKEN_QUOTA=1000000

# Default messages sent as context when user has no personal setting
HISTORY_LIMIT=20

# Phase 5
STREAMING_ENABLED=true
# How often (seconds) Telegram status message is refreshed while streaming
STREAM_EDIT_INTERVAL=1.2
# Default daily token budget per user (written to user_quotas on first use)
DEFAULT_DAILY_TOKEN_QUOTA=50000
# Overall lifetime token cap per user (generous; not tiny)
DEFAULT_LIFETIME_TOKEN_QUOTA=3000000
# Warn users when they reach this % of lifetime cap
LIFETIME_WARN_PCT=75
# Storage hygiene
KEEP_MESSAGES_IN_ACTIVE_CHAT=40
SKIP_USAGE_TABLE=true
QUOTA_APPLIES_TO_OWN_KEYS=false
# Comma-separated Telegram user IDs allowed to use /admin
ADMIN_TELEGRAM_IDS=

# Manus agent mode (https://open.manus.ai/docs) — optional shared key
MANUS_API_KEY=
MANUS_BASE_URL=https://api.manus.ai
MANUS_DEFAULT_PROFILE=standard
MANUS_TIMEOUT_SEC=90
MANUS_POLL_INTERVAL=4
# Optional: en, zh-CN, ja, ... — leave empty to omit (safer)
MANUS_LOCALE=
# Concurrency queue (protect free-tier 128MB RAM)
MANUS_MAX_CONCURRENT=2
MANUS_QUEUE_MAX=15
MANUS_MAX_PER_USER=1
# Keep multi-turn Manus session alive for follow-up edits (seconds)
MANUS_FOLLOWUP_TTL_SEC=7200
# Unlock stale Manus jobs after this many seconds (thread hang recovery)
MANUS_STALE_LOCK_SEC=180
# Ready-made prompts gallery (opens in browser)
PROMPTOPIA_URL=https://mohsen-niksirat.github.io/promptopia/
PROMPTOPIA_LABEL=📚 پرامپت‌های آماده
# Run sql/05_user_prompts_modes.sql for saved prompts + bot_mode column
